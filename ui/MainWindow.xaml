<Window x:Class="RA2Hook.RuntimeUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RA2Hook Runtime" Width="920" Height="560"
        MinWidth="760" MinHeight="500" WindowStartupLocation="CenterScreen"
        Background="#FFFFFF">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="#D6DAE1" BorderThickness="0,0,0,1"
            Padding="16,12" Background="#FFFFFF">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="RA2Hook Runtime" FontSize="20" FontWeight="SemiBold"
                     Foreground="#172033" VerticalAlignment="Center" />
          <TextBlock x:Name="ConnectionText" Text="未连接" Margin="16,2,0,0"
                     Foreground="#6B7280" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="SessionText" Text="菜单" Margin="0,0,16,0"
                     Foreground="#4B5563" VerticalAlignment="Center" />
          <CheckBox x:Name="AutoApplyCheck" Content="自动应用" VerticalAlignment="Center"
                    Checked="AutoApplyChanged" Unchecked="AutoApplyChanged" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="#F7F8FA" Padding="12,8"
            BorderBrush="#D6DAE1" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="游戏目录" VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBox x:Name="GameRootText" Grid.Column="1" MinWidth="320" />
        <Button Grid.Column="2" Content="浏览" Click="BrowseRoot" Margin="8,0,0,0" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="12,8"
            BorderBrush="#D6DAE1" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button Content="新建补丁" Click="NewPatch" />
          <Button Content="保存" Click="SavePatch" />
          <Button Content="刷新文件" Click="RefreshFiles" />
          <Button x:Name="ApplyButton" Content="应用" Click="ApplyPatch" />
          <Button x:Name="RollbackButton" Content="回滚" Click="RollbackPatch" />
          <Button Content="删除" Click="DeletePatch" />
        </StackPanel>
        <TextBlock x:Name="RuntimePathText" Grid.Column="1" Margin="14,0,0,0"
                   Foreground="#6B7280" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#F7F8FA" BorderBrush="#D6DAE1"
               BorderThickness="0,1,0,0">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="等待连接" Foreground="#4B5563" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="KeyCountText" Foreground="#6B7280" />
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" MinWidth="160" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="8" />
        <RowDefinition Height="150" MinHeight="100" />
      </Grid.RowDefinitions>

      <Border Grid.Column="0" Grid.Row="0" BorderBrush="#D6DAE1" BorderThickness="1"
              Background="#FFFFFF">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="运行时补丁" FontWeight="SemiBold"
                     Padding="10,9" Background="#F7F8FA" />
          <ListBox x:Name="FilesList" SelectionChanged="PatchSelected"
                   BorderThickness="0" Padding="4">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="28">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                            Tag="{Binding}" Click="PatchEnabledChanged"
                            ToolTip="启用或停用此补丁" VerticalAlignment="Center"
                            Margin="3,0,7,0" />
                  <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Grid.Row="0" Width="8" HorizontalAlignment="Stretch"
                    Background="Transparent" ShowsPreview="True" />

      <TabControl Grid.Column="2" Grid.Row="0" x:Name="MainTabs">
        <TabItem Header="编辑器">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="10,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="SelectedFileText" Foreground="#6B7280"
                         Text="未选择文件" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBox x:Name="PatchNameText" Grid.Column="1" MinHeight="27"
                       VerticalContentAlignment="Center" IsEnabled="False" />
              <Button x:Name="RenameButton" Grid.Column="2" Content="重命名"
                      Click="RenamePatch" IsEnabled="False" Margin="8,0,0,0" />
            </Grid>
            <TextBox x:Name="EditorText" Grid.Row="1" AcceptsReturn="True"
                     AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextChanged="EditorChanged"
                     FontFamily="Consolas" FontSize="13" Padding="10"
                     BorderBrush="#D6DAE1" />
          </Grid>
        </TabItem>
        <TabItem Header="运行结果">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="ResultFilterText" Margin="8" MinHeight="30"
                     TextChanged="ResultFilterChanged" />
            <DataGrid x:Name="RuntimeGrid" Grid.Row="1" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
              <DataGrid.Columns>
                <DataGridTextColumn Header="段" Binding="{Binding Section}" Width="110" />
                <DataGridTextColumn Header="键" Binding="{Binding Key}" Width="120" />
                <DataGridTextColumn Header="旧值" Binding="{Binding OldValue}" Width="*" />
                <DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="*" />
                <DataGridTextColumn Header="安全等级" Binding="{Binding Safety}" Width="120" />
                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="160" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Height="8"
                    HorizontalAlignment="Stretch" Background="Transparent" ShowsPreview="True" />

      <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" BorderBrush="#D6DAE1"
              BorderThickness="1" Background="#FFFFFF">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="日志" FontWeight="SemiBold"
                     Padding="10,7" Background="#F7F8FA" />
          <TextBox x:Name="LogText" IsReadOnly="True" BorderThickness="0" Padding="10"
                   FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
